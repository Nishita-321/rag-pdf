# Non-secret settings. Becomes the "app-config" ConfigMap.
# Same variables as .env; see docs/04-config-and-gemini.md.
LLM_MODEL=gemini-3.5-flash
EMBED_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
CHROMA_PATH=/data/chroma_db
COLLECTION_NAME=documents
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO
LOG_QUESTIONS=false
